NEXT_PUBLIC_BASE_PATH=/gastro
# Serverseitige Adresse der autoritativen NestJS-API für Next.js-Proxy-Routen.
KIJU_API_INTERNAL_URL=http://127.0.0.1:4000/api
# Öffentliche HTTPS-Basisadresse für gedruckte Selbstbestell-QR-Codes.
